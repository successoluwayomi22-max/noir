APP_NAME="Noir & Co."
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_KEY=replace-with-a-random-32-plus-character-secret

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=noir
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

SESSION_NAME=noir_session
SESSION_SECURE=false

# Keep this false locally unless PHP/XAMPP has been configured to send mail.
# Email contents are still written to storage/logs for local verification.
MAIL_ENABLED=false
MAIL_FROM_ADDRESS=no-reply@noir.test
MAIL_FROM_NAME="Noir & Co."
CONTACT_TO_EMAIL=your-contact-inbox@example.com

# Brevo (formerly Sendinblue) transactional email API key.
BREVO_API_KEY=

# Local development baseline scanner. Replace with ClamAV or another host-managed scanner in production.
MALWARE_SCANNER_COMMAND="php crons/local-upload-scanner.php {file}"

# Google OAuth credentials for Sign in with Google.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Google reCAPTCHA bot protection (leave empty in local dev to bypass)
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Shopping assistant. Configure either OpenAI or an OpenAI-compatible provider
# such as OpenRouter. Keys are server-side only and must never be committed.
AI_ASSISTANT_ENABLED=false
AI_PROVIDER=openai
AI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
AI_API_BASE_URL=
AI_MODEL=gpt-5.6-luna
AI_ASSISTANT_TIMEOUT=20
AI_ASSISTANT_MAX_REQUESTS=12
AI_ASSISTANT_RATE_LIMIT_WINDOW=600

# Keep live keys out of version control. Use Paystack test keys during setup.
PAYMENT_DEFAULT_PROVIDER=paystack
PAYMENT_CURRENCIES=NGN,USD,GBP,EUR
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# ---------------------------------------------------------------------------
# Production example — copy the values you need into your real .env.
# NEVER commit real credentials, hostnames, or API keys to this template.
# ---------------------------------------------------------------------------

# APP_NAME="Noir & Co"
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://your-production-domain.com
# DB_CONNECTION=mysql
# DB_HOST=your-production-db-host
# DB_PORT=3306
# DB_DATABASE=your_database_name
# DB_USERNAME=your_database_user
# DB_PASSWORD=your_database_password